include(GNUInstallDirs)
if(IS_ABSOLUTE "${CMAKE_INSTALL_BINDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_LIBEXECDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_DATADIR}")
    message(FATAL_ERROR "CPNetFlux relocatable packages require relative GNUInstallDirs")
endif()
install(TARGETS cpnetflux cpnetflux-server cpnetflux-client cpnetflux-file-server
    cpnetflux-file-client cpnetflux-file-download-client cpnetflux-tree-upload-client
    cpnetflux-tree-download-client cpnetflux-auth-probe cpnetflux-gridftp-server RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
configure_file(packaging/cpnetflux-service.in "${CMAKE_CURRENT_BINARY_DIR}/cpnetflux-service" @ONLY)
configure_file(packaging/cpnetflux-server-setup.in "${CMAKE_CURRENT_BINARY_DIR}/cpnetflux-server-setup" @ONLY)
install(PROGRAMS "${CMAKE_CURRENT_BINARY_DIR}/cpnetflux-service" DESTINATION ${CMAKE_INSTALL_BINDIR})
install(PROGRAMS "${CMAKE_CURRENT_BINARY_DIR}/cpnetflux-server-setup" DESTINATION ${CMAKE_INSTALL_BINDIR})
install(FILES packaging/cpnetflux_service.py packaging/cpnetflux_server_setup.py
    DESTINATION ${CMAKE_INSTALL_LIBEXECDIR}/cpnetflux)
install(FILES packaging/server.example.json packaging/cpnetflux-server.service
    packaging/cpnetflux-agent.service packaging/cpnetflux.sysusers packaging/cpnetflux.tmpfiles
    DESTINATION ${CMAKE_INSTALL_DATADIR}/cpnetflux/deployment)
install(FILES docs/release/linux-install.md DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/cpnetflux)
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE CPNETFLUX_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT CPNETFLUX_REVISION MATCHES "^[0-9a-f]+$")
    set(CPNETFLUX_REVISION "source-archive")
endif()
string(SUBSTRING "${CPNETFLUX_REVISION}" 0 12 CPNETFLUX_REVISION_SHORT)
set(CPNETFLUX_PACKAGE_VERSION "${PROJECT_VERSION}+git.${CPNETFLUX_REVISION_SHORT}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/build-info.json"
    "{\n  \"project\": \"CPNetFlux\",\n  \"version\": \"${CPNETFLUX_PACKAGE_VERSION}\",\n  \"source_revision\": \"${CPNETFLUX_REVISION}\",\n  \"tls\": ${CPNETFLUX_HAS_TLS},\n  \"desktop\": \"${CPNETFLUX_BUILD_DESKTOP}\",\n  \"architecture\": \"${CMAKE_SYSTEM_PROCESSOR}\",\n  \"public_release_ready\": false\n}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/build-info.json" DESTINATION ${CMAKE_INSTALL_DATADIR}/cpnetflux)
set(CPACK_PACKAGE_NAME cpnetflux)
set(CPACK_PACKAGE_VENDOR CPNetFlux)
set(CPACK_PACKAGE_CONTACT "CPNetFlux project")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "CPNetFlux internal Linux delivery candidate")
set(CPACK_PACKAGE_VERSION "${CPNETFLUX_PACKAGE_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "cpnetflux-${CPNETFLUX_PACKAGE_VERSION}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_GENERATOR "TGZ;DEB")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "python3")
if(CPNETFLUX_BUILD_DESKTOP)
    string(APPEND CPACK_DEBIAN_PACKAGE_DEPENDS ", python3-jsonschema, qt6-qpa-plugins, qml6-module-qtquick, qml6-module-qtquick-templates, qml6-module-qtquick-controls, qml6-module-qtquick-layouts, qml6-module-qtquick-window, qml6-module-qtqml-workerscript")
endif()
set(CPACK_DEBIAN_PACKAGE_SECTION net)
include(CPack)
